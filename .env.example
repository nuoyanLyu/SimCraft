# Copy to .env at the repo root and fill in. Never commit the filled-in file.

# --- Teacher (hosted API, OpenAI-compatible relay) ---
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_MODEL=claude-sonnet-5
TEACHER_MIN_OUTPUT_TOKENS=8000

# --- Simulator (local vLLM, see scripts/serve_simulator.sh) ---
SIMULATOR_BASE_URL=http://localhost:8000/v1
SIMULATOR_API_KEY=EMPTY
SIMULATOR_MODEL=Qwen-AgentWorld-35B-A3B

# --- Agent (local vLLM, see scripts/serve_agent.sh) ---
AGENT_BASE_URL=http://localhost:8001/v1
AGENT_API_KEY=EMPTY
AGENT_MODEL=Qwen3-8B
