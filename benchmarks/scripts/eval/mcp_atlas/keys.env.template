# MCP-Atlas server API keys for the EnvFactory paper subset (30 servers).
# Fill in what you have; leave blank to skip that server (its tasks are skipped).
# This file is merged into mcp-atlas/.env by setup_env.sh (survives regeneration).
#
# ── No data import, just an API key ───────────────────────────────────────────
# national-parks  | free, instant. https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=
# weather-data    | free tier. https://www.weatherapi.com/  (sign up -> API key)
WEATHER_API_KEY=
# twelvedata      | free tier. https://twelvedata.com/  (sign up -> Dashboard -> API key)
TWELVE_DATA_API_KEY=
# exa (search)    | free credits. https://dashboard.exa.ai/  -> API Keys
EXA_API_KEY=
# e2b (code sbx)  | free tier. https://e2b.dev/  -> Dashboard -> API Keys
E2B_API_KEY=
# alchemy (web3)  | free tier. https://dashboard.alchemy.com/  -> Apps -> API Key
ALCHEMY_API_KEY=
# lara-translate  | free tier. https://developers.laratranslate.com/  -> credentials
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=
# github          | PAT (classic or fine-grained). https://github.com/settings/tokens
#                 | ⚠️ USE A THROWAWAY ACCOUNT: the agent performs real repo operations.
#                 | The throwaway account login itself belongs in a password
#                 | manager, not here -- this file is a tracked template.
GITHUB_TOKEN=
# google-maps     | Google Cloud (needs billing enabled; has free monthly credit).
#                 | https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=
#
# ── API key + import the provided sample data (see mcp-atlas/data_exports/README.md) ──
# airtable        | 1) create account 2) open the shared base URL in data_exports/README
#                 |    and click "Copy base" 3) create token https://airtable.com/create/tokens
#                 |    (scopes: data.records:read/write, schema.bases:read + access to the base)
AIRTABLE_API_KEY=
# notion          | 1) create account 2) Settings > Import the mcp-atlas-notion-data.zip
#                 |    3) https://www.notion.so/profile/integrations -> new Internal integration
#                 |    -> Internal Integration Secret. Also share the imported pages with it.
NOTION_TOKEN=
