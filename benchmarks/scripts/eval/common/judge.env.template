# External LLM used by benchmarks that need a user-simulator / LLM-as-judge
# (tau2-Bench, VitaBench, MCP-Atlas). Follows the EnvFactory paper setup:
# DeepSeek-V3.2 served via dmxapi. The API key is reused from EnvFactory/.env
# (EMBEDDING_API_KEY), which is a dmxapi key.
export JUDGE_BASE_URL="https://www.dmxapi.cn/v1"
export JUDGE_MODEL="DeepSeek-V3.2"
# JUDGE_API_KEY is loaded at runtime from EnvFactory/.env EMBEDDING_API_KEY
# Tracked template. Nothing sources this file today -- the runners default
# JUDGE_BASE_URL/JUDGE_MODEL themselves -- so it documents the judge setup.
# It stays a .template because benchmarks/**/*.env is gitignored wholesale:
# no *.env under benchmarks/ is ever allowed into a commit, key or no key.
